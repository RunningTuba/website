# Copy to `.env` and fill in the values.
#
#   cp .env.example .env
#
# `.env` is gitignored — never commit the real key.

# Resend API key from https://resend.com/api-keys — starts with "re_".
RESEND_API_KEY=re_your_key_here

# Where project briefs are delivered. Comma-separate for multiple inboxes.
#
# NOTE: while CONTACT_FROM_EMAIL uses onboarding@resend.dev (below), Resend only
# delivers to the Resend account owner and compares the address
# case-sensitively, so this must be lowercase.
CONTACT_TO_EMAIL=andy@runningtuba.com

# The sender.
#
# onboarding@resend.dev is Resend's shared testing sender. It works immediately
# but ONLY delivers to the Resend account owner's own inbox.
#
# For production, verify runningtuba.com at https://resend.com/domains and use:
#   CONTACT_FROM_EMAIL=Running Tuba Website <website@runningtuba.com>
CONTACT_FROM_EMAIL=Running Tuba Website <onboarding@resend.dev>
