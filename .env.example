# Copy to `.env` and fill in the values.
#
#   cp .env.example .env
#
# `.env` is gitignored — never commit the real key.

# Resend API key from https://resend.com/api-keys — starts with "re_".
RESEND_API_KEY=re_your_key_here

# Where project briefs are delivered. Comma-separate for multiple inboxes.
CONTACT_TO_EMAIL=andy@runningtuba.com

# The sender. The domain must be verified at https://resend.com/domains or Resend
# rejects the send with a 403. Running Tuba sends from the verified subdomain
# send.runningtuba.com.
#
# For local testing without a verified domain, Resend's shared sender works but
# only delivers to the Resend account owner's own inbox:
#   CONTACT_FROM_EMAIL=Running Tuba Website <onboarding@resend.dev>
CONTACT_FROM_EMAIL=Running Tuba Website <website@send.runningtuba.com>
